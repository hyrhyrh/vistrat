# ========================================
# AI Watchdog Docker Compose 通用环境变量（示例）
# 拷贝为 .env 后按实际环境修改
# ========================================

# ========================================
# Docker用户映射
# ========================================
DOCKER_UID=1000
DOCKER_GID=1000

# ========================================
# 服务端口映射
# ========================================
BACKEND_PORT=16532
FRONTEND_PORT=3009

# ========================================
# 数据库配置 (PostgreSQL)
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vision_db
DB_USER=vision
DB_PASSWORD=change_me

# ========================================
# MinIO 对象存储配置
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_SECURE=false

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6679
REDIS_PASSWORD=change_me
REDIS_DB=2
REDIS_PREFIX=multi_watchdog

# ========================================
# Elasticsearch 配置
# ========================================
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=elastic
ES_PASSWORD=change_me
ES_SSL=false

# ========================================
# AI API 配置
# ========================================

# Claude API
CLAUDE_API_KEY=change_me
CLAUDE_API_URL=https://api.bltcy.ai/v1
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Qwen API (通义千问)
QWEN_API_KEY=change_me
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-max

# Moonshot API (月之暗面)
MOONSHOT_API_KEY=change_me
MOONSHOT_API_URL=https://api.moonshot.cn/v1/chat/completions
MOONSHOT_MODEL=moonshot-v1-8k

# DeepSeek API
DEEPSEEK_API_KEY=change_me
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# ========================================
# 向量数据库配置 (可选)
# ========================================
ENABLE_RAG=false
VECTOR_API_URL=http://127.0.0.1:8085/add_text/

# ========================================
# 应用配置
# ========================================
HOST=0.0.0.0
PORT=16532
ENV=production
DEBUG=false
RELOAD=false
LOG_LEVEL=INFO

# 公网访问配置 - 用于生成可公网访问的图片代理URL
PUBLIC_BASE_URL=http://<edge_ip_or_domain>:16532

# ========================================
# 安全配置
# ========================================
# CORS 允许的源，多个用逗号分隔（生产环境必须配置为实际域名）
CORS_ORIGINS=http://localhost:3000,http://localhost:3009

# ========================================
# JWT认证配置
# ========================================
JWT_SECRET_KEY=change_me
JWT_EXPIRE_HOURS=24

# ========================================
# 视频处理配置
# ========================================
VIDEO_INTERVAL=1800
ANALYSIS_INTERVAL=10
BUFFER_DURATION=11
FRAME_SAMPLE_INTERVAL=5
STREAM_FRAME_INTERVAL=5
ENABLE_STREAM_AI_LOGGING=true

# ========================================
# 性能优化配置
# ========================================
MAX_CONCURRENT_STREAMS=50
MAX_CONCURRENT_AI_CALLS=150
STREAM_BUFFER_BATCH_SIZE=200
STREAM_BUFFER_FLUSH_INTERVAL=7

# ========================================
# 数据库连接池配置
# ========================================
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=45
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ========================================
# Vistrat 推理服务（A100 Tier 2，另一台机器）
# ========================================
INFERENCE_ENABLED=true
INFERENCE_BASE_URL=http://<a100_host>:8100
INFERENCE_API_KEY=<change-me>
INFERENCE_TIMEOUT=30
INFERENCE_MAX_RETRIES=2
INFERENCE_BREAKER_WINDOW=30
INFERENCE_BREAKER_THRESHOLD=5
INFERENCE_BREAKER_COOLDOWN=60
INFERENCE_PRESIGNED_EXPIRES=900

# ========================================
# mediamtx 流媒体 + 告警片段裁剪
# ========================================
MEDIAMTX_HOST=mediamtx
MEDIAMTX_API_PORT=9997
MEDIAMTX_HLS_PORT=8888
# 容器内录制根目录（与 docker-compose 挂载点一致）
MEDIAMTX_RECORDING_ROOT=/recordings
# 单 segment 时长（秒），需与 mediamtx.yml recordSegmentDuration 对齐
MEDIAMTX_SEGMENT_DURATION=10
# 告警裁剪窗口（告警前 N 秒 + 告警后 M 秒）
CLIP_PRE_SECONDS=5
CLIP_POST_SECONDS=10

# ========================================
# 前端配置
# ========================================
REACT_APP_API_URL=http://<edge_ip_or_domain>:16532
